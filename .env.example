# ==============================================================================
# TÀI LIỆU ĐỈNH — CẤU HÌNH BIẾN MÔI TRƯỜNG BẢO MẬT (.env.example)
#
# NGUYÊN TẮC AN TOÀN:
# 1. TUYỆT ĐỐI KHÔNG thêm tiền tố NEXT_PUBLIC_ cho Service Role Key, Private Key hoặc Passwords.
# 2. KHÔNG commit tệp .env hoặc .env.local chứa khóa thật vào Git repository.
# ==============================================================================

# ─── 1. SUPABASE (NGUỒN DỮ LIỆU CHÍNH THỨC) ───
# URL dự án Supabase của bạn (ví dụ: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Key: Khóa công khai dùng cho phía Client (tuân thủ nghiêm ngặt RLS)
# Người dùng dùng Anon Key chỉ có thể SELECT dữ liệu đã xuất bản (status = 'published')
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here

# Service Role Key: KHÓA ĐẶC QUYỀN CAO NHẤT (BỎ QUA RLS)
# CẢNH BÁO: CHỈ ĐƯỢC DÙNG TRONG BACKEND / ROUTE HANDLERS PHÍA MÁY CHỦ
# TUYỆT ĐỐI KHÔNG ĐƯA VÀO BUNDLE JAVASCRIPT TRÌNH DUYỆT
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_secret_service_role_key_here

# ─── 2. GOOGLE SHEETS TRANSITION (CHỈ DÙNG PHÍA MÁY CHỦ NẾU CẦN ĐỒNG BỘ) ───
# Khi bảng tính Google Sheets được chuyển sang chế độ "Restricted" (Riêng tư),
# backend sử dụng Service Account JSON credentials để đọc dữ liệu server-to-server.
GOOGLE_SHEETS_RESTRICTED_ID=1wQQXVthJrTmYSJPJfuGJ3kbHdi3YnhM1_Dch1QAZvuM
GOOGLE_SERVICE_ACCOUNT_EMAIL=sync-bot@tai-lieu-dinh.iam.gserviceaccount.com
# Private key nhiều dòng hoặc đường dẫn đến file credentials bí mật trên máy chủ:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...=\n-----END PRIVATE KEY-----\n"

# ─── 3. CẤU HÌNH VẬN HÀNH DỰ ÁN ───
NEXT_PUBLIC_APP_URL=https://cauph96-design.github.io/tai-lieu-dinh
NEXT_PUBLIC_ZALO_PHONE=0926999869
NEXT_PUBLIC_ZALO_LINK=https://zalo.me/0926999869
NODE_ENV=development
